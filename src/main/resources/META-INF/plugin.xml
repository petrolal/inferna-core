<idea-plugin>
    <id>org.inferna.core</id>
    <name>Inferna Core</name>
    <vendor email="petrolalucas@gmail.com" url="https://github.com/petrolal/inferna-core">Lucas Henrique Novais de Araujo Petrola</vendor>

    <!-- Essential platform dependencies -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>
    <depends>org.jetbrains.kotlin</depends>

    <!-- Optional Polyglot Content Modules: each descriptor below (modules/scala, modules/groovy)
         lives in its own lib/modules/*.jar and is activated by the platform only when its own
         <dependencies><plugin id="..."/></dependencies> is satisfied — never classloaded otherwise. -->
    <content>
        <module name="inferna-core.modules.scala"/>
        <module name="inferna-core.modules.groovy"/>
    </content>

    <applicationListeners>
        <listener class="org.inferna.core.InfernaLifecycleListener"
                  topic="com.intellij.ide.ui.LafManagerListener"/>
    </applicationListeners>

    <extensionPoints>
        <!-- Freemium SPI: a separately distributed inferna-pro plugin registers its own
             implementation here with order="first" to outrank DefaultInfernaLicenseProvider. -->
        <extensionPoint qualifiedName="org.inferna.core.licenseProvider"
                         interface="org.inferna.core.licensing.InfernaLicenseProvider"
                         dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceInterface="org.inferna.core.licensing.InfernaLicenseService"
                             serviceImplementation="org.inferna.core.licensing.InfernaLicenseServiceImpl"/>

        <!-- Safe post-startup execution (COMPONENTS_LOADED) -->
        <postStartupActivity implementation="org.inferna.core.InfernaStartupActivity"/>

        <advancedSetting id="org.inferna.branding.enabled"
                         default="true"
                         bundle="messages.InfernaBundle"
                         groupKey="advanced.setting.group.inferna"/>

        <themeProvider id="org.inferna.theme.visceral" path="/theme/inferna.theme.json" targetUi="islands"/>
        <bundledColorScheme id="Inferna Visceral Dark" path="/theme/inferna.xml"/>

        <toolWindow id="Inferna Biometrics"
                    factoryClass="org.inferna.dashboard.InfernaDashboardToolWindowFactory"
                    anchor="right"
                    secondary="false"/>

        <!-- Spring tooling: each self-disables at runtime (SpringBeanResolver.isNativeSpringPluginActive)
             whenever IntelliJ IDEA Ultimate's bundled com.intellij.spring plugin is installed and
             enabled, so Community gets gutter navigation/inspections and Ultimate never sees
             duplicate markers. No separate content module needed: this code only depends on UAST
             and generic PSI, never on com.intellij.spring classes. -->
        <codeInsight.lineMarkerProvider language="JAVA"
                                         implementationClass="org.inferna.spring.SpringBeanLineMarkerProvider"/>
        <codeInsight.lineMarkerProvider language="kotlin"
                                         implementationClass="org.inferna.spring.SpringBeanLineMarkerProvider"/>

        <localInspection groupName="Inferna Spring"
                          shortName="InfernaUnresolvedSpringBean"
                          enabledByDefault="true"
                          level="WARNING"
                          implementationClass="org.inferna.spring.UnresolvedSpringBeanInspection"
                          displayName="Unresolved or ambiguous Spring bean injection"/>

        <psi.referenceContributor implementation="org.inferna.spring.SpringValueReferenceContributor"/>
    </extensions>

    <extensions defaultExtensionNs="org.inferna.core">
        <!-- Open-core fallback: always present, always last. An inferna-pro plugin registers its
             own licenseProvider with order="first" to become the active one with no code change here. -->
        <licenseProvider implementation="org.inferna.core.licensing.DefaultInfernaLicenseProvider" order="last"/>
    </extensions>

    <!-- Without this, any plugin declaring <depends>org.jetbrains.kotlin</depends> is treated as
         K1-only and the platform refuses to load it at all once K2 mode is active — regardless
         of what the plugin's own bytecode actually references (UAST here is K1/K2-agnostic). -->
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true"/>
    </extensions>
</idea-plugin>