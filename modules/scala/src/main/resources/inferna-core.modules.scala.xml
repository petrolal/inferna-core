<idea-plugin>
    <!-- Content-module descriptor (see root plugin.xml's <content><module name="inferna-core.modules.scala"/></content>).
         Only activated by the platform when org.intellij.scala is actually present/enabled. -->
    <dependencies>
        <plugin id="org.intellij.scala"/>
    </dependencies>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceInterface="org.inferna.scala.ScalaAnalyzerBridge"
                             serviceImplementation="org.inferna.modules.scala.ScalaAnalyzerBridgeImpl"/>
    </extensions>
</idea-plugin>
